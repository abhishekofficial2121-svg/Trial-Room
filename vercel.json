{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "fastapi"
    },
    "demo-store": {
      "root": "apps/demo-store",
      "framework": "nextjs",
      "use": "@vercel/nextjs",
      "outputDirectory": ".next"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "demo-store" } }
  ]
}