# =============================================================================
# Trial Room — Environment Configuration (V1)
# Copy to .env and fill in values before running locally.
# Never commit real secrets to version control.
# =============================================================================

# --- Application ---
APP_NAME=trial-room
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=info
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Security ---
SESSION_SECRET_KEY=change-me-in-production-min-32-chars
JWT_SECRET_KEY=change-me-in-production-min-32-chars
ENCRYPTION_KEY=change-me-32-byte-base64-value

# --- Database (PostgreSQL) ---
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=trialroom
POSTGRES_PASSWORD=changeme
POSTGRES_DB=trialroom
DATABASE_URL=postgresql+psycopg2://trialroom:changeme@db:5432/trialroom

# --- Cache / Queue (Redis) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CELERY_BROKER_URL=redis://:changeme@redis:6379/0
CELERY_RESULT_BACKEND=redis://:changeme@redis:6379/1

# --- Object Storage (S3-compatible / MinIO) ---
STORAGE_PROVIDER=minio
STORAGE_BUCKET=trialroom-assets
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
STORAGE_ENDPOINT=http://minio:9000
STORAGE_REGION=us-east-1
STORAGE_USE_SSL=false

# --- AI / Try-on ---
# Set to 'mock' for development without a real model. Never use mock in production.
TRYON_PROVIDER=mock
TRYON_MODEL_ID=placeholder
TRYON_DEVICE=cpu
TRYON_WORKER_CONCURRENCY=1

# --- Retention (minutes) ---
SESSION_TTL_MINUTES=30
MAX_ASSET_LIFETIME_MINUTES=60
CLEANUP_INTERVAL_MINUTES=5

# --- Merchant ---
MERCHANT_API_KEY=changeme-merchant-key

# --- Feature flags ---
MOCK_MODE=false
ENABLE_CAMERA_UPLOAD=true